  "drivers": [
    {
      "id": "civx-fan",
      "name": {
        "en": "Philips Civx Ceiling Fan",
        "no": "Philips Civx takvifte"
      },
      "class": "fan",
      "capabilities": [
        "onoff",
        "civx_speed",
        "civx_speed_1",
        "civx_speed_2",
        "civx_speed_3",
        "civx_speed_4",
        "civx_speed_5",
        "civx_speed_6",
        "civx_reverse",
        "civx_sleep",
        "civx_timer_1h",
        "civx_timer_3h",
        "civx_timer_6h"
      ],
      "capabilitiesOptions": {
        "onoff": {
          "title": {
            "en": "Power",
            "no": "Av/pa"
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "rf433"
      ],
      "images": {
        "small": "/drivers/civx-fan/assets/images/small.png",
        "large": "/drivers/civx-fan/assets/images/large.png",
        "xlarge": "/drivers/civx-fan/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "start",
          "navigation": {
            "next": "listen"
          }
        },
        {
          "id": "listen"
        },
        {
          "id": "probe"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "About",
            "no": "Om"
          },
          "children": [
            {
              "id": "app_version",
              "type": "label",
              "label": {
                "en": "App version",
                "no": "App-versjon"
              },
              "hint": {
                "en": "The version actually running on this Homey. Set by the app itself when it starts, so it confirms an install has taken effect rather than repeating what app.json claims.",
                "no": "Versjonen som faktisk kjorer pa denne Homey-en. Settes av appen selv nar den starter, sa den bekrefter at en installasjon har tatt effekt i stedet for a gjenta det app.json pastar."
              },
              "value": "unknown"
            },
            {
              "id": "app_started",
              "type": "label",
              "label": {
                "en": "Running since",
                "no": "Kjort siden"
              },
              "hint": {
                "en": "When this version last started. A recent time means the install has just gone live.",
                "no": "Nar denne versjonen sist startet. Et nylig tidspunkt betyr at installasjonen nettopp ble aktiv."
              },
              "value": "unknown"
            },
            {
              "id": "fan_address",
              "type": "label",
              "label": {
                "en": "Fan address",
                "no": "Vifteadresse"
              },
              "hint": {
                "en": "The 24-bit address this fan answers to, discovered during pairing. Every Civx learns its own remote, so this differs per fan.",
                "no": "Den 24-bits adressen denne viften svarer pa, funnet under paring. Hver Civx laerer sin egen fjernkontroll, sa denne er ulik per vifte."
              },
              "value": "unknown"
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Radio",
            "no": "Radio"
          },
          "children": [
            {
              "id": "repetitions",
              "type": "number",
              "label": {
                "en": "Repetitions per press",
                "no": "Gjentakelser per trykk"
              },
              "hint": {
                "en": "How many times each code is transmitted. The original remote sends 5. Raise this if the fan is far from Homey and misses commands.",
                "no": "Hvor mange ganger hver kode sendes. Originalfjernkontrollen sender 5. Ok denne hvis viften star langt fra Homey og mister kommandoer."
              },
              "value": 8,
              "min": 1,
              "max": 60
            },
            {
              "id": "signal_variant",
              "type": "dropdown",
              "label": {
                "en": "Signal timing variant",
                "no": "Signaltiming-variant"
              },
              "hint": {
                "en": "Frame shape. 'Capture-exact' matches the recorded remote byte-for-byte. Switch to 'Trailing pulse' only if the fan does not react at all.",
                "no": "Rammeform. 'Capture-exact' matcher opptaket av fjernkontrollen eksakt. Bytt til 'Trailing pulse' bare hvis viften ikke reagerer i det hele tatt."
              },
              "value": "default",
              "values": [
                {
                  "id": "default",
                  "label": {
                    "en": "Capture-exact (no trailing pulse)",
                    "no": "Capture-exact (uten sluttpuls)"
                  }
                },
                {
                  "id": "eof",
                  "label": {
                    "en": "Trailing pulse (Homey convention)",
                    "no": "Sluttpuls (Homey-konvensjon)"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Power button behaviour",
            "no": "Oppforsel for av/pa-knappen"
          },
          "children": [
            {
              "id": "onoff_speed",
              "type": "dropdown",
              "label": {
                "en": "Speed used when turned on",
                "no": "Hastighet som brukes ved paslag"
              },
              "hint": {
                "en": "Which speed step On selects when Homey has no previous speed stored.",
                "no": "Hvilket hastighetstrinn Pa velger nar Homey ikke har lagret en tidligere hastighet."
              },
              "value": "3",
              "values": [
                {
                  "id": "1",
                  "label": {
                    "en": "1",
                    "no": "1"
                  }
                },
                {
                  "id": "2",
                  "label": {
                    "en": "2",
                    "no": "2"
                  }
                },
                {
                  "id": "3",
                  "label": {
                    "en": "3",
                    "no": "3"
                  }
                },
                {
                  "id": "4",
                  "label": {
                    "en": "4",
                    "no": "4"
                  }
                },
                {
                  "id": "5",
                  "label": {
                    "en": "5",
                    "no": "5"
                  }
                },
                {
                  "id": "6",
                  "label": {
                    "en": "6",
                    "no": "6"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Remote tracking",
            "no": "Sporing av fjernkontroll"
          },
          "children": [
            {
              "id": "track_remote",
              "type": "checkbox",
              "label": {
                "en": "Follow the physical remote",
                "no": "Folg den fysiske fjernkontrollen"
              },
              "hint": {
                "en": "Homey listens on 433 MHz for the original remote and updates this device to match what the remote told the fan to do. Turn off if it causes false readings.",
                "no": "Homey lytter pa 433 MHz etter originalfjernkontrollen og oppdaterer denne enheten til a matche det fjernkontrollen ba viften om. Skru av hvis det gir feil avlesninger."
              },
              "value": true
            }
          ]
        }
      ]
    }
  ],
