      "type": "enum",
      "title": {
        "en": "Speed",
        "no": "Hastighet"
      },
      "desc": {
        "en": "A six-segment bar showing fan speed: all segments empty when off, filling left to right for speeds 1-6. Follows both Homey and the physical remote. Pick this as the device's status indicator.",
        "no": "En sekssegments stolpe som viser viftehastighet: alle segmenter tomme nar den er av, fylles fra venstre mot hoyre for hastighet 1-6. Folger bade Homey og den fysiske fjernkontrollen. Velg denne som statusindikator."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg",
      "values": [
        {
          "id": "off",
          "title": {
